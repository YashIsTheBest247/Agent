# --- Gemini (agent runtime) -------------------------------------------------
# Required. Server-side only: never prefix with NEXT_PUBLIC_.
# Without it the site runs and every page works; uploads return a 503 that
# says exactly what is missing.
GEMINI_API_KEY=

# Model routing. Mechanical extraction goes to the fast model; strategy,
# drafting and adversarial review get the reasoning model.
GEMINI_MODEL_REASONING=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-2.5-flash

# --- App --------------------------------------------------------------------
# Only used for absolute URLs in metadata. Vercel sets its own domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Record storage ---------------------------------------------------------
# Runs are written as JSON so they survive a restart. On by default locally,
# off on Vercel, where the filesystem is ephemeral and persisting there would
# promise more than it delivers. Set to 1 to force it on, 0 to force it off.
# SECOND_CHAIR_PERSIST=1
# SECOND_CHAIR_DATA_DIR=./.data
