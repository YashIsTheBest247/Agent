# --- Gemini (agent runtime) -------------------------------------------------
# Required from the next build onward. Server-side only: never prefix NEXT_PUBLIC_.
GEMINI_API_KEY=

# Model routing. Heavy reasoning vs. cheap extraction/classification passes.
GEMINI_MODEL_REASONING=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-2.5-flash

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
